{
  "components": {
    "schemas": {
      "ErreurDeChamp": {
        "description": "Une erreur de validation (`422`) : `pointer` pour le corps, `parameter` pour le reste.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "parameter": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ParametreEnCause"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "pointer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "JSON Pointer (RFC 6901) vers le champ du corps.",
            "title": "Pointer"
          }
        },
        "required": [
          "message"
        ],
        "title": "ErreurDeChamp",
        "type": "object"
      },
      "Etat": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Etat",
        "type": "object"
      },
      "ParametreEnCause": {
        "description": "Le paramètre de requête, d'en-tête ou de chemin que la validation a refusé.",
        "properties": {
          "in": {
            "description": "query, header, path ou cookie",
            "title": "In",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "in"
        ],
        "title": "ParametreEnCause",
        "type": "object"
      },
      "ProblemDetails": {
        "description": "Le corps de toute erreur de l'API (RFC 9457). Sa forme est celle que `reponse()` produit.",
        "properties": {
          "code": {
            "description": "Code machine stable, par exemple `base_indisponible`.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErreurDeChamp"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Seulement pour `422`.",
            "title": "Errors"
          },
          "instance": {
            "description": "Identifiant de la requête, repris dans le journal.",
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "URI stable du problème : `https://notre-popote.fr/problemes/<code>`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "title": "ProblemDetails",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Popote",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Etat"
                }
              }
            },
            "description": "Le processus répond."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Erreur interne"
          }
        },
        "summary": "Le processus répond",
        "tags": [
          "santé"
        ]
      }
    },
    "/api/readyz": {
      "get": {
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Etat"
                }
              }
            },
            "description": "La base répond."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Erreur interne"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service indisponible"
          }
        },
        "summary": "Le processus et sa base répondent",
        "tags": [
          "santé"
        ]
      }
    }
  }
}
