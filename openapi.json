{
  "components": {
    "schemas": {
      "ErreurDeChamp": {
        "description": "Une erreur de validation (`422`) : `pointer` pour le corps, `parameter` pour le reste.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "parameter": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ParametreEnCause"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "pointer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "JSON Pointer (RFC 6901) vers le champ du corps.",
            "title": "Pointer"
          }
        },
        "required": [
          "message"
        ],
        "title": "ErreurDeChamp",
        "type": "object"
      },
      "Etat": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Etat",
        "type": "object"
      },
      "FoyerResume": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "FoyerResume",
        "type": "object"
      },
      "Moi": {
        "description": "La personne connectée, telle qu'elle se voit : de quoi afficher son nom, son foyer et son adresse.",
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Le prénom affiché ; absent sans profil.",
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "L'adresse de connexion ; absente si le compte n'en a pas.",
            "title": "Email"
          },
          "household": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FoyerResume"
              },
              {
                "type": "null"
              }
            ],
            "description": "Le foyer de la personne ; absent sans profil."
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "household"
        ],
        "title": "Moi",
        "type": "object"
      },
      "ParametreEnCause": {
        "description": "Le paramètre de requête, d'en-tête ou de chemin que la validation a refusé.",
        "properties": {
          "in": {
            "description": "query, header, path ou cookie",
            "title": "In",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "in"
        ],
        "title": "ParametreEnCause",
        "type": "object"
      },
      "ProblemDetails": {
        "description": "Le corps de toute erreur de l'API (RFC 9457). Sa forme est celle que `reponse()` produit.",
        "properties": {
          "code": {
            "description": "Code machine stable, par exemple `base_indisponible`.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErreurDeChamp"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Seulement pour `422`.",
            "title": "Errors"
          },
          "instance": {
            "description": "Identifiant de la requête, repris dans le journal.",
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "URI stable du problème : `https://notre-popote.fr/problemes/<code>`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "Sante": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Sante",
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "__Host-popote_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Popote",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sante"
                }
              }
            },
            "description": "Le processus répond.",
            "headers": {
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Erreur interne",
            "headers": {
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service indisponible",
            "headers": {
              "Retry-After": {
                "description": "Secondes à attendre avant de réessayer (entier, RFC 9110 § 10.2.3).",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Le processus répond",
        "tags": [
          "santé"
        ]
      }
    },
    "/api/readyz": {
      "get": {
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Etat"
                }
              }
            },
            "description": "La base répond.",
            "headers": {
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Erreur interne",
            "headers": {
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service indisponible",
            "headers": {
              "Retry-After": {
                "description": "Secondes à attendre avant de réessayer (entier, RFC 9110 § 10.2.3).",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Le processus et sa base répondent",
        "tags": [
          "santé"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "get_me",
        "parameters": [
          {
            "description": "Étiquettes déjà connues du client ; `304` si l'une correspond.",
            "in": "header",
            "name": "If-None-Match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Étiquettes déjà connues du client ; `304` si l'une correspond.",
              "title": "If-None-Match"
            }
          },
          {
            "description": "Étiquette de la version lue ; `412` si elle n'est plus la bonne.",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Étiquette de la version lue ; `412` si elle n'est plus la bonne.",
              "title": "If-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Moi"
                }
              }
            },
            "description": "La personne, son adresse et son foyer.",
            "headers": {
              "ETag": {
                "description": "Empreinte du contenu (fort).",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Non modifiée : `If-None-Match` correspond à l'`ETag` actuel.",
            "headers": {
              "Cache-Control": {
                "description": "Celui du `200`.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Empreinte du contenu, celle du `200`.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Requête mal formée",
            "headers": {
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Pas de session",
            "headers": {
              "WWW-Authenticate": {
                "description": "Le défi : `Cookie realm=\"popote\"`.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Introuvable",
            "headers": {
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Précondition échouée",
            "headers": {
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Validation Error",
            "headers": {
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Trop de requêtes",
            "headers": {
              "RateLimit": {
                "description": "Ce qui reste de la fenêtre (IETF draft-ietf-httpapi-ratelimit-headers).",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Le quota et la fenêtre de la politique (même brouillon IETF).",
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Secondes à attendre avant de réessayer (entier, RFC 9110 § 10.2.3).",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Erreur interne",
            "headers": {
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service indisponible",
            "headers": {
              "Retry-After": {
                "description": "Secondes à attendre avant de réessayer (entier, RFC 9110 § 10.2.3).",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "Identifiant de la requête, repris dans le journal et dans `instance` d'une erreur.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "La personne connectée",
        "tags": [
          "moi"
        ]
      }
    }
  }
}
